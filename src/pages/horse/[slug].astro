---
/**
 * A página de um cavalo.
 *
 * Os cinco blocos da §3 do handoff: identificação, carreira, por condição
 * (terreno / pista / faixa de distância), jóquei e treinador, linhagem.
 *
 * ⚠️ TRÊS REGRAS GOVERNAM O TEXTO DESTA PÁGINA, e não são estilo:
 *
 * 1. `status` tem três valores e cada um exige palavra diferente. As frases
 *    moram em `lib/horse-copy.mjs`, o mesmo arquivo que a checagem 25 importa
 *    para conferir página por página. Escrever "debut" para um `no_record`
 *    transforma lacuna nossa em fato sobre o animal.
 * 2. O limite do arquivo (`history_through`) aparece NA PÁGINA, não só no JSON.
 *    "Career: 83 runs" sem dizer até quando mente por omissão.
 * 3. Amostra ao lado de toda taxa. É a `HorseStatTable` que garante a forma, e
 *    a checagem 27 que recusa o build se escapar.
 *
 * ⚠️ E uma regra de palavra que vem da medição independente, não do gosto:
 * **não se AFIRMA "career"** enquanto o arquivo tiver os buracos conhecidos.
 * Medido: 86% dos cavalos declarados hoje correram depois do fim do arquivo, e
 * "career: 83 runs" seria um número verdadeiro há dois meses. A palavra só
 * aparece onde serve para NEGAR a leitura ("what our archive holds, not the
 * horse's official career") — que é o oposto de afirmá-la.
 *
 * O que NÃO está aqui, e por quê: nada de preço, nada de palpite, nada de
 * previsão. A página descreve o que aconteceu, com a data de corte junto.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import RailIndex from '../../components/RailIndex.astro';
import HorseStatTable from '../../components/HorseStatTable.astro';
import DataAge from '../../components/DataAge.astro';
import {
  loadRecords, loadCard, horseMeta, statusSentence, statusLabel, plural, bandLabel,
  type HorseRecord, type DistanceBand,
} from '../../lib/horses';
import { archiveLine, ukDate, rideWithHorse, yardWithHorse, pairingLine, sireAtDistanceLine, atCourse, atDistance, recentLine, daysSince } from '../../lib/horse-copy.mjs';
import { raceTime, raceZone } from '../../lib/time';
import { canonicalUrl } from '../../lib/canonical';

export function getStaticPaths() {
  // O cartão é lido UMA vez e viaja nas props. Lido dentro da página, seriam
  // 863 aberturas do mesmo arquivo — uma por página, e crescendo todo dia.
  const card = loadCard();
  const stamp = {
    collectedThrough: card.collected_through,
    generatedAt: card.generated_at,
    cardDate: card.horses[0]?.as_of ?? null,
    bands: card.distance_bands ?? [],
  };
  return loadRecords().map((h) => ({ params: { slug: h.slug }, props: { h, stamp } }));
}

interface Props {
  h: HorseRecord;
  stamp: {
    collectedThrough: string | null;
    generatedAt: string;
    cardDate: string | null;
    bands: DistanceBand[];
  };
}
const { h, stamp } = Astro.props;

/**
 * ⚠️ O CARIMBO DE COLETA É DO CARTÃO, NÃO DO REGISTRO — e os dois divergem.
 *
 * O acervo é acumulado: hoje 187 dos 863 registros estão no cartão lido agora,
 * e os outros 676 são de cartões anteriores. Estampar a hora da coleta de hoje
 * na página de um cavalo que não foi declarado hoje é a mesma confusão que o
 * `collected_through` existe para desfazer, só que ao contrário: frescor de uma
 * coleta que não olhou para este registro.
 *
 * Então a página diz qual dos dois casos é. E o caso "não declarado" só é
 * afirmável PORQUE houve coleta: sem `collected_through` não dá para distinguir
 * "não foi declarado" de "não olhamos", e a página não afirma nem um nem outro.
 */
const onLatestCard = stamp.cardDate !== null && h.as_of === stamp.cardDate;
const collectionKnown = Boolean(stamp.collectedThrough && !Number.isNaN(Date.parse(stamp.collectedThrough)));

const meta = horseMeta(h);
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const decl = h.last_declared;
const zone = raceZone(decl.off_utc);

const hasGroups = h.by_going.length + h.by_course.length + h.by_distance.length > 0;
const connections = [
  h.jockey ? { label: 'Jockey', sub: h.jockey.name, group: h.jockey } : null,
  h.trainer ? { label: 'Trainer', sub: h.trainer.name, group: h.trainer } : null,
].filter((x) => x !== null);

/**
 * As parcerias do contrato v2. Cada frase é null quando a origem não emitiu o
 * bloco — e ela só emite acima do piso de amostra —, então a página nunca
 * escolhe entre publicar ruído e mentir por omissão: a frase simplesmente não
 * aparece, que é o mesmo contrato de `not held` do resto daqui.
 */
const withHorse = [rideWithHorse(h.jockey_here), yardWithHorse(h.trainer_here)]
  .filter((x) => x !== null);
const pairing = pairingLine(h.jockey_trainer);

/**
 * v3 — as condições de HOJE, e a atividade recente.
 *
 * `hereToday` junta os quatro recortes numa frase só por pessoa: quatro
 * parágrafos de uma linha cada seriam uma tabela disfarçada de prosa, e a
 * decisão da grade editorial foi o contrário disso.
 */
const condicoes = [
  { papel: 'Jockey', partes: [atCourse(h.jockey_at_course),
      atDistance(h.jockey_at_distance, bandLabel(stamp.bands, h.jockey_at_distance?.key ?? '') ?? null)],
    nome: h.jockey_at_course?.name ?? h.jockey_at_distance?.name },
  { papel: 'Trainer', partes: [atCourse(h.trainer_at_course),
      atDistance(h.trainer_at_distance, bandLabel(stamp.bands, h.trainer_at_distance?.key ?? '') ?? null)],
    nome: h.trainer_at_course?.name ?? h.trainer_at_distance?.name },
].map((x) => ({ ...x, partes: x.partes.filter((p) => p !== null) }))
 .filter((x) => x.partes.length > 0);

const atividade = [recentLine(h.recent_30d), recentLine(h.recent_90d)].filter((x) => x !== null);
const desde = daysSince(h.days_since_last_run);
const sireDistance = sireAtDistanceLine(
  h.sire_at_distance,
  h.sire_at_distance ? (bandLabel(stamp.bands, h.sire_at_distance.key) ?? null) : null,
);

/**
 * As seções, definidas UMA vez e usadas nos dois lugares: no índice da margem e
 * nos próprios títulos. A checagem 22 confere que os dois batem, e a única
 * forma de nunca falharem é não existirem em duplicidade.
 */
const sections = [
  { id: 'record', title: 'The record we hold' },
  ...(h.status === 'has_history' ? [{ id: 'conditions', title: 'By going, course and distance' }] : []),
  ...(h.days_since_last_run !== undefined || h.recent_90d ? [{ id: 'recent', title: 'Recent activity' }] : []),
  ...(connections.length ? [{ id: 'connections', title: 'Jockey and trainer' }] : []),
  ...(h.sire ? [{ id: 'sire', title: 'Sire' }] : []),
];

/**
 * Dado estruturado: `Dataset`, e a escolha é deliberada.
 *
 * `schema.org` não tem tipo para cavalo de corrida. Entre marcar `Thing` vazio
 * e marcar honestamente o que a página É — um conjunto pequeno de estatísticas
 * derivadas, com janela temporal, autor e licença —, `Dataset` descreve melhor
 * e usa campos que existem para isto: `temporalCoverage`, `variableMeasured`,
 * `dateModified`.
 *
 * ⛔ SEM `distribution`. É o campo que apontaria para um arquivo baixável, e
 * despejo em massa do dado é exatamente o que o ToS do fornecedor proíbe e o
 * que a regra 6 do handoff nomeia. A ausência aqui é política, não esquecimento.
 *
 * `temporalCoverage` usa intervalo ISO 8601 de início aberto ("../data"): o
 * registro diz até quando o arquivo vai, e NÃO diz desde quando — inventar um
 * começo seria afirmar profundidade que este arquivo não declara.
 */
const measured = h.career.runs > 0
  ? [
      { '@type': 'PropertyValue', name: 'Runs', value: h.career.runs },
      { '@type': 'PropertyValue', name: 'Wins', value: h.career.wins },
      { '@type': 'PropertyValue', name: 'Placed', value: h.career.places },
      ...(h.career.win_pct !== null ? [{ '@type': 'PropertyValue', name: 'Win rate', value: h.career.win_pct, unitText: 'PERCENT' }] : []),
      ...(h.career.place_pct !== null ? [{ '@type': 'PropertyValue', name: 'Placed rate', value: h.career.place_pct, unitText: 'PERCENT' }] : []),
    ]
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': `${canonical}#dataset`,
  url: canonical,
  name: `${h.name}: race record by going, course and distance band`,
  description: meta.description,
  inLanguage: 'en-GB',
  isAccessibleForFree: true,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  creator: { '@id': 'https://mazetick.com/#org' },
  publisher: { '@id': 'https://mazetick.com/#org' },
  // `isPartOf` aqui apontava para o WebSite, e o Search Console recusou em
  // 21/09/2026: num Dataset esse campo tem de apontar para outro Dataset. O
  // jeito certo de dizer "este conjunto mora num acervo maior" é
  // `includedInDataCatalog`, que é o campo que o Google documenta para Dataset.
  // O catálogo vai inteiro, e não por @id: a página de cavalo não define o nó
  // do catálogo, e referência que a própria página não resolve o Google não
  // resolve também.
  includedInDataCatalog: {
    '@type': 'DataCatalog',
    '@id': 'https://mazetick.com/horse#catalog',
    name: 'mazetick horse records',
    url: 'https://mazetick.com/horse',
  },
  dateModified: h.as_of,
  temporalCoverage: `../${h.history_through}`,
  ...(measured.length ? { variableMeasured: measured } : {}),
};
---
<BaseLayout title={meta.title} description={meta.description} jsonLd={jsonLd}>
  <header class="mast">
    <p class="mono kicker">Horse record &middot; UK &amp; Irish racing</p>
    <h1 class="display title">{h.name}</h1>
  </header>

  <div class="spread">
    <div class="body">
      <p class="lead">{statusSentence(h)}</p>

      {/*
        Identificação. Idade, sexo, dono e mãe entraram no contrato v2 em
        2026-09-24 e vêm do CARTÃO, nunca inferidos do histórico: idade muda
        todo ano, e deduzi-la da corrida mais recente do arquivo publicaria a
        idade de então como se fosse a de hoje.

        `colour` chega no dado e NÃO vai para a tela: vem como código (`b`,
        `ch`, `gr`), e expandir exigiria uma tabela que ninguém publica.
        Expandir errado é pior que omitir.

        Onde o campo não existe, a resposta é "not held", nunca zero: ausência
        significa que não temos amostra, e nunca que a amostra é nula.
      */}
      <dl class="ident">
        <div>
          <dt>Age</dt>
          <dd>{h.ident?.age ? `${h.ident.age}yo` : <span class="faint">not held</span>}</dd>
        </div>
        <div>
          <dt>Sex</dt>
          <dd>{h.ident?.sex ?? <span class="faint">not held</span>}</dd>
        </div>
        <div>
          <dt>Last declared</dt>
          <dd>
            {decl.venue}, {raceTime(decl.off_utc)} {zone}, {ukDate(decl.date)}
          </dd>
        </div>
        <div>
          <dt>Going that day</dt>
          <dd>{decl.going}</dd>
        </div>
        <div>
          <dt>Distance band</dt>
          {/*
            A chave vai dentro do seu próprio elemento, e não solta antes do
            <span>. Solta, o HTML servido fica "mile<span…>7f to 1m1f", e a
            checagem 2 reclama com razão: ela não sabe que o `.band` é
            `display: block`, e no dia em que o CSS mudar a tela diria
            "mile7f to 1m1f". Com os dois elementos irmãos, o pior caso é um
            espaço a mais.
          */}
          <dd>
            <span class="key">{decl.distance}</span>
            {bandLabel(stamp.bands, decl.distance) && (
              <span class="band">{bandLabel(stamp.bands, decl.distance)}</span>
            )}
          </dd>
        </div>
        <div>
          <dt>Trainer</dt>
          <dd>{h.trainer ? h.trainer.name : <span class="faint">not held</span>}</dd>
        </div>
        <div>
          <dt>Owner</dt>
          <dd>{h.ident?.owner ?? <span class="faint">not held</span>}</dd>
        </div>
        <div>
          <dt>Jockey that day</dt>
          <dd>{h.jockey ? h.jockey.name : <span class="faint">not held</span>}</dd>
        </div>
        <div>
          <dt>Sire</dt>
          <dd>{h.sire ? h.sire.name : <span class="faint">not held</span>}</dd>
        </div>
        <div>
          <dt>Dam</dt>
          <dd>{h.ident?.dam ?? <span class="faint">not held</span>}</dd>
        </div>
      </dl>
    </div>

    <aside class="rail">
      <RailIndex items={sections} />
      <div class="rail-block">
        <span class="rail-label">As at</span>
        <dl class="stamp-list">
          <div><dt>Figures as at</dt><dd>{ukDate(h.as_of)}</dd></div>
          <div><dt>Archive through</dt><dd>{ukDate(h.history_through)}</dd></div>
          <div>
            <dt>Sample held</dt>
            <dd>{h.status === 'has_history' ? plural(h.career.runs, 'run') : 'none'}</dd>
          </div>
          <div><dt>State</dt><dd>{statusLabel(h.status)}</dd></div>
        </dl>
      </div>
      <div class="rail-block">
        <span class="rail-label">Collection</span>
        <p class="rail-note">
          {!collectionKnown
            ? 'This file carries no collection timestamp, so we cannot say when the card was last read, nor whether this horse has been declared since.'
            : onLatestCard
              ? 'This horse was declared on the card we last read.'
              : 'This horse was not on the card we last read. The figures above are carried forward from the day it was, and nothing about it has changed since.'}
        </p>
        <DataAge collectedThrough={stamp.collectedThrough} generatedAt={stamp.generatedAt} />
      </div>
      <div class="rail-block">
        <span class="rail-label">No look-ahead</span>
        <p class="rail-note">
          Every figure below uses only races run before the date above. Nothing here
          is a prediction, and nothing here is a price.
        </p>
      </div>
    </aside>
  </div>

  <section>
    <h2 id="record" class="section-rule">The record we hold</h2>
    {h.status === 'has_history' ? (
      <>
        <HorseStatTable
          firstCol="Record"
          rows={[{ label: 'All runs we hold', group: h.career }]}
        />
        <p class="note caption on-axis">{archiveLine(h.history_through)}</p>
      </>
    ) : (
      <div class="empty">
        <p class="lead">
          There is no record line, no going split, no course split and no distance
          split, because there is nothing to split. The tables that would carry them
          are absent rather than empty, which is the same thing said honestly.
        </p>
        <p class="note">
          {archiveLine(h.history_through)}
          {(connections.length > 0 || h.sire) && (
            <span>
              {' '}The blocks below are records of other parties &mdash; the yard, the
              rider, the sire &mdash; and they stand whatever this horse has done.
            </span>
          )}
        </p>
      </div>
    )}
  </section>

  {h.status === 'has_history' && (
    <section>
      <h2 id="conditions" class="section-rule">By going, course and distance</h2>
      {hasGroups ? (
        <>
          <p class="lead on-axis">
            The portals show a rolling recent window because that is what their feed
            delivers. These are every run we hold, split by the conditions of the day
            and cut at the archive date &mdash; with the sample beside each rate,
            because a rate without one is a guess with a decimal point.
          </p>

          {h.by_going.length > 0 && <HorseStatTable firstCol="Going" rows={h.by_going.map((g) => ({ label: g.key, group: g }))} />}
          {h.by_course.length > 0 && <HorseStatTable firstCol="Course" rows={h.by_course.map((g) => ({ label: g.key, group: g }))} />}
          {h.by_distance.length > 0 && (
            <HorseStatTable
              firstCol="Distance band"
              subPlain
              rows={h.by_distance.map((g) => ({ label: g.key, sub: bandLabel(stamp.bands, g.key), group: g }))}
            />
          )}

          <p class="note caption on-axis">
            A going, course or distance band appears only where we hold at least two
            runs of it. A single run is not a strike rate, and rounding one run to
            &ldquo;100%&rdquo; would be noise wearing the clothes of a finding. Going
            and distance are grouped into bands by us, and{' '}
            <strong>each band carries the range it covers</strong>, because a rate over
            &ldquo;staying&rdquo; is unreadable without it; the course is as the record
            names it.
          </p>
        </>
      ) : (
        <div class="empty">
          {/*
            ⚠️ Guarda de plural. A /extra-places já publicou "the other 1 were
            already…" por não ter uma, e aqui o caso de UMA corrida é o mais
            comum dos três: hoje são 90 cavalos com corrida demais para "sem
            registro" e de menos para qualquer recorte.
          */}
          <p class="lead">
            No single going, course or distance band reaches the two runs we require
            before quoting a rate.{' '}
            {h.career.runs === 1
              ? 'We hold one run for this horse, and one run is not a strike rate.'
              : `We hold ${h.career.runs} runs for this horse, and they are spread too thin to split.`}
          </p>
          <p class="note">
            This is a statement about the sample, not about the horse. The line above
            is the whole of what we hold.
          </p>
        </div>
      )}
    </section>
  )}

  {(atividade.length > 0 || desde) && (
    <section>
      <h2 id="recent" class="section-rule">Recent activity</h2>
      <p class="on-axis">
        {desde && `${desde}. `}
        {atividade.length > 0 && `It had run ${atividade.join(', and ')}.`}
      </p>
      <p class="note caption on-axis">
        Counts, not rates &mdash; one win from two runs is not a fifty per cent
        strike rate, it is two runs. Everything here is cut at {ukDate(h.as_of)}.
      </p>
    </section>
  )}

  {connections.length > 0 && (
    <section>
      <h2 id="connections" class="section-rule">Jockey and trainer</h2>
      <HorseStatTable firstCol="Connection" rows={connections} />
      {/*
        Até v2 esta legenda gastava um parágrafo avisando o que a página NÃO
        dizia — "not their record with this horse". O aviso existia porque o
        dado faltava. Agora existe, e a página responde a leitura natural em
        vez de pedir desculpa por não responder. O que sobra do aviso é o que
        continua verdade: a TABELA é de arquivo inteiro.
      */}
      <p class="note caption on-axis">
        <strong>The table above is the whole-archive record, not this pairing.</strong>{' '}
        Those figures are the rider&rsquo;s across every ride we hold and the
        yard&rsquo;s across every runner we hold, to {ukDate(h.history_through)}.
        {(withHorse.length > 0 || pairing) && ' What follows is narrower.'}
      </p>
      {withHorse.length > 0 && (
        <p class="on-axis">
          {withHorse.join(', and ')}.
        </p>
      )}
      {pairing && <p class="on-axis">{pairing}</p>}
      {condicoes.length > 0 && (
        <p class="on-axis">
          {/* O prefixo sai UMA vez: repeti-lo por pessoa lia como gerador. */}
          Under today&rsquo;s conditions,{' '}
          {condicoes.map((c) => c.partes.join(', and ')).join('; ')}.{' '}
          <span class="faint">Course and distance are taken one at a time, not together.</span>
        </p>
      )}
    </section>
  )}

  {h.sire && (
    <section>
      <h2 id="sire" class="section-rule">Sire</h2>
      <HorseStatTable firstCol="Sire" rows={[{ label: h.sire.name, sub: 'all progeny in our archive', group: h.sire }]} />
      <p class="note caption on-axis">
        The sire&rsquo;s progeny across every run we hold to {ukDate(h.history_through)}.
        It is a statement about the stallion&rsquo;s stock in general, not about this
        horse{sireDistance ? '' : ', and not conditioned on the going, the course or the distance above'}.
      </p>
      {/*
        `sire_at_distance` condiciona SÓ a distância. Terreno e pista continuam
        de fora, e a frase tem de continuar dizendo isso — senão a página teria
        trocado uma ressalva honesta por uma implicação falsa.
      */}
      {sireDistance && (
        <p class="on-axis">
          {sireDistance} Going and course are not held constant here.
        </p>
      )}
    </section>
  )}

  <p class="note foot caption on-axis">
    Figures are our own count over an archive of published race results, computed using
    only races run before {ukDate(h.as_of)}. A rate is shown only where we hold at
    least two runs of that kind. Race times are {zone}. mazetick publishes measurements,
    not tips: nothing here is advice to bet, and no price appears on this page.{' '}
    <a href="/horse">All horses in the archive</a>.
  </p>
</BaseLayout>

<style>
  .mast .title { max-width: 20ch; }
  .lead { margin-bottom: var(--sp-5); }
  section { margin-top: var(--sp-14); }
  /* Sem régua própria: o `.section-rule` acima já desenha uma, e duas linhas
     a poucos pixels uma da outra leem como defeito de renderização. */
  .empty { padding-top: var(--sp-2); }

  /* Identificação: rótulo mono sobre valor, em colunas que quebram sozinhas.
     Não é tabela porque não há amostra nem taxa — é ficha, e tabelar ficha
     sugeriria que há números a comparar. */
  .ident {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--col-min), 1fr));
    gap: var(--sp-5) var(--sp-6);
    border-top: 1px solid var(--rule-med);
    padding-top: var(--sp-5);
  }
  .ident dt {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--sp-1);
  }
  .ident dd {
    margin: 0;
    font-size: var(--fs-body);
    color: var(--ink);
  }
  .ident .faint { color: var(--ink-faint); }
  /* O intervalo da faixa, colado à chave: "staying" sozinho não é conferível. */
  .ident .band {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    color: var(--ink-faint);
    margin-top: var(--sp-1);
  }
  /* Na margem o carimbo empilha: 300px não comportam a linha do .age em fila. */
  .rail-block :global(.age) { flex-direction: column; gap: var(--sp-1); margin-top: var(--sp-2); }

  .stamp-list dt {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .stamp-list dd {
    margin: 0 0 var(--sp-3);
    font-size: var(--fs-caption);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .stamp-list div:last-child dd { margin-bottom: 0; }
</style>
