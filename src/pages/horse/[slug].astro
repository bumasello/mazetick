---
/**
 * A página de um cavalo.
 *
 * Os cinco blocos da §3 do handoff: identificação, carreira, por condição
 * (terreno / pista / faixa de distância), jóquei e treinador, linhagem.
 *
 * ⚠️ TRÊS REGRAS GOVERNAM O TEXTO DESTA PÁGINA, e não são estilo:
 *
 * 1. `status` tem três valores e cada um exige palavra diferente. As frases
 *    moram em `lib/horse-copy.mjs`, o mesmo arquivo que a checagem 25 importa
 *    para conferir página por página. Escrever "debut" para um `no_record`
 *    transforma lacuna nossa em fato sobre o animal.
 * 2. O limite do arquivo (`history_through`) aparece NA PÁGINA, não só no JSON.
 *    "Career: 83 runs" sem dizer até quando mente por omissão.
 * 3. Amostra ao lado de toda taxa. É a `HorseStatTable` que garante a forma, e
 *    a checagem 27 que recusa o build se escapar.
 *
 * O que NÃO está aqui, e por quê: nada de preço, nada de palpite, nada de
 * previsão. A página descreve o que aconteceu, com a data de corte junto.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import RailIndex from '../../components/RailIndex.astro';
import HorseStatTable from '../../components/HorseStatTable.astro';
import { loadRecords, horseMeta, statusSentence, statusLabel, plural, type HorseRecord } from '../../lib/horses';
import { archiveLine, ukDate } from '../../lib/horse-copy.mjs';
import { raceTime, raceZone } from '../../lib/time';
import { canonicalUrl } from '../../lib/canonical';

export function getStaticPaths() {
  return loadRecords().map((h) => ({ params: { slug: h.slug }, props: { h } }));
}

interface Props { h: HorseRecord }
const { h } = Astro.props;

const meta = horseMeta(h);
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const decl = h.last_declared;
const zone = raceZone(decl.off_utc);

const hasGroups = h.by_going.length + h.by_course.length + h.by_distance.length > 0;
const connections = [
  h.jockey ? { label: 'Jockey', sub: h.jockey.name, group: h.jockey } : null,
  h.trainer ? { label: 'Trainer', sub: h.trainer.name, group: h.trainer } : null,
].filter((x) => x !== null);

/**
 * As seções, definidas UMA vez e usadas nos dois lugares: no índice da margem e
 * nos próprios títulos. A checagem 22 confere que os dois batem, e a única
 * forma de nunca falharem é não existirem em duplicidade.
 */
const sections = [
  { id: 'record', title: 'The record we hold' },
  ...(h.status === 'has_history' ? [{ id: 'conditions', title: 'By going, course and distance' }] : []),
  ...(connections.length ? [{ id: 'connections', title: 'Jockey and trainer' }] : []),
  ...(h.sire ? [{ id: 'sire', title: 'Sire' }] : []),
];

/**
 * Dado estruturado: `Dataset`, e a escolha é deliberada.
 *
 * `schema.org` não tem tipo para cavalo de corrida. Entre marcar `Thing` vazio
 * e marcar honestamente o que a página É — um conjunto pequeno de estatísticas
 * derivadas, com janela temporal, autor e licença —, `Dataset` descreve melhor
 * e usa campos que existem para isto: `temporalCoverage`, `variableMeasured`,
 * `dateModified`.
 *
 * ⛔ SEM `distribution`. É o campo que apontaria para um arquivo baixável, e
 * despejo em massa do dado é exatamente o que o ToS do fornecedor proíbe e o
 * que a regra 6 do handoff nomeia. A ausência aqui é política, não esquecimento.
 *
 * `temporalCoverage` usa intervalo ISO 8601 de início aberto ("../data"): o
 * registro diz até quando o arquivo vai, e NÃO diz desde quando — inventar um
 * começo seria afirmar profundidade que este arquivo não declara.
 */
const measured = h.career.runs > 0
  ? [
      { '@type': 'PropertyValue', name: 'Runs', value: h.career.runs },
      { '@type': 'PropertyValue', name: 'Wins', value: h.career.wins },
      { '@type': 'PropertyValue', name: 'Placed', value: h.career.places },
      ...(h.career.win_pct !== null ? [{ '@type': 'PropertyValue', name: 'Win rate', value: h.career.win_pct, unitText: 'PERCENT' }] : []),
      ...(h.career.place_pct !== null ? [{ '@type': 'PropertyValue', name: 'Placed rate', value: h.career.place_pct, unitText: 'PERCENT' }] : []),
    ]
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': `${canonical}#dataset`,
  url: canonical,
  name: `${h.name}: race record by going, course and distance band`,
  description: meta.description,
  inLanguage: 'en-GB',
  isAccessibleForFree: true,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  creator: { '@id': 'https://mazetick.com/#org' },
  publisher: { '@id': 'https://mazetick.com/#org' },
  isPartOf: { '@id': 'https://mazetick.com/#website' },
  dateModified: h.as_of,
  temporalCoverage: `../${h.history_through}`,
  ...(measured.length ? { variableMeasured: measured } : {}),
};
---
<BaseLayout title={meta.title} description={meta.description} jsonLd={jsonLd}>
  <header class="mast">
    <p class="mono kicker">Horse record &middot; UK &amp; Irish racing</p>
    <h1 class="display title">{h.name}</h1>
  </header>

  <div class="spread">
    <div class="body">
      <p class="lead">{statusSentence(h)}</p>

      {/*
        Identificação. Só o que o registro traz — idade, sexo, mãe e dono não
        estão neste contrato, e uma linha vazia é melhor que um campo inventado.
        Onde o bloco do produtor não existe, a resposta é "not held", nunca zero:
        ausência significa que não temos amostra, e nunca que a amostra é nula.
      */}
      <dl class="ident">
        <div>
          <dt>Last declared</dt>
          <dd>
            {decl.venue}, {raceTime(decl.off_utc)} {zone}, {ukDate(decl.date)}
          </dd>
        </div>
        <div>
          <dt>Going that day</dt>
          <dd>{decl.going}</dd>
        </div>
        <div>
          <dt>Distance band</dt>
          <dd>{decl.distance}</dd>
        </div>
        <div>
          <dt>Trainer</dt>
          <dd>{h.trainer ? h.trainer.name : <span class="faint">not held</span>}</dd>
        </div>
        <div>
          <dt>Jockey that day</dt>
          <dd>{h.jockey ? h.jockey.name : <span class="faint">not held</span>}</dd>
        </div>
        <div>
          <dt>Sire</dt>
          <dd>{h.sire ? h.sire.name : <span class="faint">not held</span>}</dd>
        </div>
      </dl>
    </div>

    <aside class="rail">
      <RailIndex items={sections} />
      <div class="rail-block">
        <span class="rail-label">As at</span>
        <dl class="stamp-list">
          <div><dt>Figures as at</dt><dd>{ukDate(h.as_of)}</dd></div>
          <div><dt>Archive through</dt><dd>{ukDate(h.history_through)}</dd></div>
          <div>
            <dt>Sample held</dt>
            <dd>{h.status === 'has_history' ? plural(h.career.runs, 'run') : 'none'}</dd>
          </div>
          <div><dt>State</dt><dd>{statusLabel(h.status)}</dd></div>
        </dl>
      </div>
      <div class="rail-block">
        <span class="rail-label">No look-ahead</span>
        <p class="rail-note">
          Every figure below uses only races run before the date above. Nothing here
          is a prediction, and nothing here is a price.
        </p>
      </div>
    </aside>
  </div>

  <section>
    <h2 id="record" class="section-rule">The record we hold</h2>
    {h.status === 'has_history' ? (
      <>
        <HorseStatTable
          firstCol="Career"
          rows={[{ label: 'All runs in our archive', group: h.career }]}
        />
        <p class="note caption on-axis">{archiveLine(h.history_through)}</p>
      </>
    ) : (
      <div class="empty">
        <p class="lead">
          There is no career line, no going split, no course split and no distance
          split, because there is nothing to split. The tables that would carry them
          are absent rather than empty, which is the same thing said honestly.
        </p>
        <p class="note">
          {archiveLine(h.history_through)}
          {(connections.length > 0 || h.sire) && (
            <span>
              {' '}The blocks below are records of other parties &mdash; the yard, the
              rider, the sire &mdash; and they stand whatever this horse has done.
            </span>
          )}
        </p>
      </div>
    )}
  </section>

  {h.status === 'has_history' && (
    <section>
      <h2 id="conditions" class="section-rule">By going, course and distance</h2>
      {hasGroups ? (
        <>
          <p class="lead on-axis">
            The portals show a rolling recent window because that is what their feed
            delivers. These are every run we hold, split by the conditions of the day
            and cut at the archive date &mdash; with the sample beside each rate,
            because a rate without one is a guess with a decimal point.
          </p>

          {h.by_going.length > 0 && <HorseStatTable firstCol="Going" rows={h.by_going.map((g) => ({ label: g.key, group: g }))} />}
          {h.by_course.length > 0 && <HorseStatTable firstCol="Course" rows={h.by_course.map((g) => ({ label: g.key, group: g }))} />}
          {h.by_distance.length > 0 && <HorseStatTable firstCol="Distance band" rows={h.by_distance.map((g) => ({ label: g.key, group: g }))} />}

          <p class="note caption on-axis">
            A going, course or distance band appears only where we hold at least two
            runs of it. A single run is not a strike rate, and rounding one run to
            &ldquo;100%&rdquo; would be noise wearing the clothes of a finding. Going
            and distance are grouped into bands by us; the course is as the record
            names it.
          </p>
        </>
      ) : (
        <div class="empty">
          {/*
            ⚠️ Guarda de plural. A /extra-places já publicou "the other 1 were
            already…" por não ter uma, e aqui o caso de UMA corrida é o mais
            comum dos três: hoje são 90 cavalos com corrida demais para "sem
            registro" e de menos para qualquer recorte.
          */}
          <p class="lead">
            No single going, course or distance band reaches the two runs we require
            before quoting a rate.{' '}
            {h.career.runs === 1
              ? 'We hold one run for this horse, and one run is not a strike rate.'
              : `We hold ${h.career.runs} runs for this horse, and they are spread too thin to split.`}
          </p>
          <p class="note">
            This is a statement about the sample, not about the horse. The career line
            above is the whole of what we hold.
          </p>
        </div>
      )}
    </section>
  )}

  {connections.length > 0 && (
    <section>
      <h2 id="connections" class="section-rule">Jockey and trainer</h2>
      <HorseStatTable firstCol="Connection" rows={connections} />
      <p class="note caption on-axis">
        <strong>These are career records, not this pairing.</strong> The figures are
        the rider&rsquo;s across every ride we hold and the yard&rsquo;s across every
        runner we hold, to {ukDate(h.history_through)} &mdash; not their record with
        this horse, and not their record in conditions like these. We say so because
        the natural reading is the other one.
      </p>
    </section>
  )}

  {h.sire && (
    <section>
      <h2 id="sire" class="section-rule">Sire</h2>
      <HorseStatTable firstCol="Sire" rows={[{ label: h.sire.name, sub: 'all progeny in our archive', group: h.sire }]} />
      <p class="note caption on-axis">
        The sire&rsquo;s progeny across every run we hold to {ukDate(h.history_through)}.
        It is a statement about the stallion&rsquo;s stock in general, not about this
        horse, and not conditioned on the going or the course above.
      </p>
    </section>
  )}

  <p class="note foot caption on-axis">
    Figures are our own count over an archive of published race results, computed using
    only races run before {ukDate(h.as_of)}. A rate is shown only where we hold at
    least two runs of that kind. Race times are {zone}. mazetick publishes measurements,
    not tips: nothing here is advice to bet, and no price appears on this page.{' '}
    <a href="/horse">All horses in the archive</a>.
  </p>
</BaseLayout>

<style>
  .mast .title { max-width: 20ch; }
  .lead { margin-bottom: var(--sp-5); }
  section { margin-top: var(--sp-14); }
  /* Sem régua própria: o `.section-rule` acima já desenha uma, e duas linhas
     a poucos pixels uma da outra leem como defeito de renderização. */
  .empty { padding-top: var(--sp-2); }

  /* Identificação: rótulo mono sobre valor, em colunas que quebram sozinhas.
     Não é tabela porque não há amostra nem taxa — é ficha, e tabelar ficha
     sugeriria que há números a comparar. */
  .ident {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--col-min), 1fr));
    gap: var(--sp-5) var(--sp-6);
    border-top: 1px solid var(--rule-med);
    padding-top: var(--sp-5);
  }
  .ident dt {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--sp-1);
  }
  .ident dd {
    margin: 0;
    font-size: var(--fs-body);
    color: var(--ink);
  }
  .ident .faint { color: var(--ink-faint); }

  .stamp-list dt {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .stamp-list dd {
    margin: 0 0 var(--sp-3);
    font-size: var(--fs-caption);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .stamp-list div:last-child dd { margin-bottom: 0; }
</style>
