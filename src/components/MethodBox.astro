---
// Regra 4 do site_handoff.md: todo número na tela carrega o instante em que era
// verdade. Num artigo de pesquisa isso vira amostra + janela + método + data da
// medição, visíveis ANTES do texto — não numa nota de rodapé.
//
// Desde a repaginação de 2026-09-19 ele mora na MARGEM, não num painel largo
// acima do corpo. É o mesmo conteúdo no lugar certo: a margem existe para
// carregar carimbo e amostra, e é o que distingue este site de um blog.
interface Props {
  sample: string;
  window: string;
  method: string;
  measured: string;
  /** `caminho/script.py@commit` no repositório horsing-maze. */
  derivation: string;
}
const { sample, window, method, measured, derivation } = Astro.props;

const [dPath, dCommit] = derivation.split('@');
const dHref = `https://github.com/bumasello/horsing-maze/blob/${dCommit}/${dPath}`;
const dName = dPath.split('/').pop();
---
<dl class="method rail-block">
  <div><dt class="rail-label">Sample</dt><dd class="n big">{sample}</dd></div>
  <div><dt class="rail-label">Window</dt><dd class="n">{window}</dd></div>
  <div><dt class="rail-label">Measured</dt><dd class="n">{measured}</dd></div>
  <div><dt class="rail-label">Method</dt><dd>{method}</dd></div>
  <div>
    <dt class="rail-label">Derivation</dt>
    <dd class="n">
      <a href={dHref} rel="noopener noreferrer external" target="_blank">{dName}</a>
      <span class="commit">@{dCommit.slice(0, 7)}</span>{" "}
      &mdash; the script that produced these figures, pinned to the commit that produced them.
    </dd>
  </div>
</dl>

<style>
  .method { display: flex; flex-direction: column; gap: var(--sp-4); }
  .method dt { margin-bottom: var(--sp-1); }
  .method .commit { color: var(--ink-faint); font-family: var(--font-mono); }
  .method dd {
    margin: 0;
    font-size: var(--fs-caption);
    line-height: 1.5;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .method dd.big {
    font-size: var(--fs-body);
    color: var(--ink);
  }
</style>
