---
/**
 * A idade do dado, sempre visível. Regra 4 do handoff.
 *
 * O carimbo ABSOLUTO é renderizado no HTML e está correto para sempre — é ele
 * que o leitor sem JavaScript vê, e é ele que o Google indexa. A idade
 * RELATIVA ("2 hours ago") não pode ser calculada no build: a página é
 * estática, o valor congelaria, e uma página que diz "há 2 horas" seis horas
 * depois é pior do que uma que não diz nada.
 *
 * Então a idade é calculada no navegador, e degrada de forma óbvia: o terceiro
 * estado vazio — dado velho porque a coleta quebrou — se parece com "não há
 * corrida hoje" e mentiria se passasse calado.
 */
interface Props { generatedAt: string }
const { generatedAt } = Astro.props;
const abs = generatedAt.replace('T', ' ').replace('Z', ' UTC');
---
<p class="age" data-generated={generatedAt}>
  <span class="stamp">as of {abs}</span>
  <span class="rel" hidden></span>
</p>

<style>
  .age { margin: 0; display: flex; flex-wrap: wrap; gap: var(--sp-2) var(--sp-3); align-items: baseline; }
  .rel { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--ink-faint); }
  /* Envelhecer é visível, não uma nota de rodapé. */
  .age[data-state='ageing'] .rel { color: var(--ink); }
  .age[data-state='stale'] .rel {
    color: var(--ground);
    background: var(--ink);
    padding: 2px var(--sp-2);
  }
</style>

<script is:inline>
  (function () {
    var el = document.querySelector('.age[data-generated]');
    if (!el) return;
    var t = Date.parse(el.dataset.generated);
    if (isNaN(t)) return;
    var rel = el.querySelector('.rel');

    function paint() {
      var mins = Math.floor((Date.now() - t) / 60000);
      var txt;
      if (mins < 1) txt = 'collected just now';
      else if (mins < 60) txt = 'collected ' + mins + ' min ago';
      else {
        var h = Math.floor(mins / 60);
        if (h < 48) txt = 'collected ' + h + (h === 1 ? ' hour ago' : ' hours ago');
        else txt = 'collected ' + Math.floor(h / 24) + ' days ago';
      }
      // A coleta roda de hora em hora entre 06 e 21 UTC e o arquivo é
      // regenerado 4x/dia, então um vão de algumas horas é normal e um de mais
      // de 8 não é.
      var state = mins > 1440 ? 'stale' : mins > 480 ? 'ageing' : 'fresh';
      if (state === 'stale') txt += ' — this is out of date, the collection may have stopped';
      else if (state === 'ageing') txt += ' — older than a usual gap';
      el.dataset.state = state;
      rel.textContent = txt;
      rel.hidden = false;
    }

    paint();
    setInterval(paint, 60000);
  })();
</script>
