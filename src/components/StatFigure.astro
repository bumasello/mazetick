---
interface Props {
  value: string;
  label: string;
  /** accent = "difere do padrão para cima". NUNCA "aposte aqui". */
  accent?: boolean;
}
const { value, label, accent = false } = Astro.props;
---
<div class="fig">
  <div class:list={['val', 'n', { accent }]}>{value}</div>
  <div class="mono">{label}</div>
</div>

<style>
  .fig + .fig { margin-top: var(--sp-5); }
  .val {
    font-family: var(--font-display);
    font-size: var(--fs-display-xl);
    line-height: 1;
    color: var(--ink);
  }
  .val.accent { color: var(--accent); }
  .fig .mono { margin-top: var(--label-gap); display: block; }
</style>
