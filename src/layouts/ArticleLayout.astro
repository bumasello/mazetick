---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import MethodBox from '../components/MethodBox.astro';
import RailIndex from '../components/RailIndex.astro';
import { canonicalUrl } from '../lib/canonical';

interface Props { entry: CollectionEntry<'research'>; headings: MarkdownHeading[] }
const { entry, headings } = Astro.props;
const d = entry.data;

const iso = (x: Date) => x.toISOString().slice(0, 10);
const human = (x: Date) =>
  x.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

// O índice da margem sai das PRÓPRIAS seções do markdown, com os ids que o
// Astro gera — nada escrito à mão, nada a sair de sincronia. A checagem 22
// confere assim mesmo, porque a regra vale para toda página servida.
const index = headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, title: h.text }));

// O JSON-LD sai do MESMO frontmatter que alimenta o MethodBox na tela. Uma
// fonte só: a marcação e a página não têm como discordar.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: iso(d.published),
  dateModified: iso(d.updated ?? d.published),
  inLanguage: 'en-GB',
  isAccessibleForFree: true,
  // A mesma função da <link rel="canonical">. Antes era `new URL(pathname)`
  // cru, e com `build.format: 'file'` o pathname é "/research/x.html": as cinco
  // páginas de artigo declaravam no JSON-LD uma URL que a própria canônica
  // desautorizava. A checagem 14 agora compara as duas.
  url: canonicalUrl(Astro.url.pathname, Astro.site),
  publisher: { '@id': 'https://mazetick.com/#org' },
  author: { '@id': 'https://mazetick.com/#org' },
};

// O rótulo descreve o destino da afirmação testada, não a qualidade do achado.
const verdictLabel: Record<typeof d.verdict, string> = {
  negative: 'Refuted',
  positive: 'Held up',
  inconclusive: 'Inconclusive',
};
---
<BaseLayout title={`${d.title} — mazetick`} description={d.description} jsonLd={jsonLd}>
  <article>
    <header class="mast">
      <p class="mono kicker">
        Research &middot; {verdictLabel[d.verdict]}
      </p>
      <h1 class="display title">{d.title}</h1>
      <p class="dek">{d.dek}</p>
    </header>

    <div class="spread">
      <div class="body">
        <div class="prose">
          <slot />
        </div>

        <section class="limits">
          <h2 class="section-rule">What this does not say</h2>
          <ul class="limit-list">
            {d.limits.map((l) => <li>{l}</li>)}
          </ul>
        </section>

        <p class="note foot-note">
          Published {human(d.published)}
          {d.updated && <> &middot; updated {human(d.updated)}</>}.
          mazetick publishes measurements, not tips. Figures describe what happened in
          the window stated above and are not a forecast.
        </p>
      </div>

      <aside class="rail">
        <MethodBox
          sample={d.sample}
          window={d.window}
          method={d.method}
          measured={human(d.measured)}
          derivation={d.derivation}
        />
        <RailIndex items={index} />
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .mast .title { margin-bottom: var(--sp-4); }
  .dek {
    font-family: var(--font-text);
    font-size: var(--fs-text-lead);
    line-height: 1.45;
    color: var(--ink-muted);
    max-width: 52ch;
  }
  .limits { margin-top: var(--sp-14); }
  .limit-list li {
    font-family: var(--font-text);
    font-size: var(--fs-text);
    line-height: 1.55;
    color: var(--ink-muted);
    padding-left: var(--sp-5);
    position: relative;
  }
  .limit-list li + li { margin-top: var(--sp-3); }
  .limit-list li::before {
    content: '';
    position: absolute;
    left: var(--sp-2);
    top: .75em;
    width: var(--tick);
    height: 1px;
    background: var(--ink-faint);
  }
  .foot-note {
    margin-top: var(--sp-11);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--rule-med);
  }
</style>
