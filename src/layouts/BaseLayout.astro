---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/archivo';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/base.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { canonicalUrl } from '../lib/canonical';

interface Props {
  title: string;
  description: string;
  /** JSON-LD extra da página (Article), somado ao WebSite/Organization do site. */
  jsonLd?: Record<string, unknown>;
  /** 404 e afins: fora do índice, e sem canônica que a legitime. */
  noindex?: boolean;
}

const { title, description, jsonLd, noindex = false } = Astro.props;

// Canônica absoluta a partir de `site`, nunca da URL de request — senão cada
// deploy de preview publica a sua própria canônica e compete com a produção.
//
// A normalização mora em lib/canonical.ts porque o JSON-LD do artigo precisa da
// MESMA string: quando o ArticleLayout normalizava por conta própria (e não
// normalizava), a marcação dizia ".../artigo.html" e a canônica dizia
// ".../artigo" — a página se contradizia no que ela mesma declara ser.
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://mazetick.com/#website',
      url: 'https://mazetick.com/',
      name: 'mazetick',
      description:
        'Time-stamped market data for UK and Irish horse racing. What was known, and when.',
      inLanguage: 'en-GB',
      publisher: { '@id': 'https://mazetick.com/#org' },
    },
    {
      '@type': 'Organization',
      '@id': 'https://mazetick.com/#org',
      name: 'mazetick',
      url: 'https://mazetick.com/',
    },
  ],
};

// Beacon do Cloudflare Web Analytics: cookieless, sem fingerprint, sem
// identificador persistente. Explícito aqui em vez de injetado pelo painel,
// para que seja greppável e para que a política de privacidade descreva algo
// que dá para conferir no fonte. Sem a variável (dev), não renderiza nada.
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="mazetick" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary" />

    {/*
      `set:html` é uma DIRETIVA aplicada a um elemento, não uma tag. A versão
      anterior escrevia <set:html value={...} />, o que fazia o Astro emitir um
      elemento <set> literal com o JSON-LD escapado dentro de um atributo: as 12
      páginas saíram sem nenhum bloco application/ld+json válido. Como nada
      disso aparece na tela, nenhuma revisão no navegador teria como pegar.
    */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(siteJsonLd)} />
    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    )}

    {/*
      O tema, aplicado ANTES da primeira pintura.

      O HTML servido sai SEM `data-theme`, e é isso que o Google indexa: sem
      atributo, vale `prefers-color-scheme`, que é o padrão correto para quem
      chega pela primeira vez e para quem não tem JavaScript. Este script só
      escreve o atributo para quem já escolheu, uma vez, no próprio navegador.

      Tem de ser inline e síncrono no <head>: em <body> ou com `defer` o leitor
      veria um lampejo do tema errado. E por ser inline exige hash na CSP — o
      headers.mjs o calcula a partir do HTML construído e a checagem 12 recusa o
      build se algum script servido ficar sem hash, então o hash não depende de
      ninguém lembrar de regerá-lo.

      A preferência nunca chega ao servidor: é preferência, não dado.
    */}
    <script is:inline>
      try {
        var t = localStorage.getItem('mazetick:theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch (e) {
        /* localStorage bloqueado: segue o sistema, que é o padrão correto. */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <SiteHeader />
      <main id="main">
        <slot />
      </main>
      <SiteFooter />
    </div>
    {beaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${beaconToken}"}`}
      />
    )}
  </body>
</html>
